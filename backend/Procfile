web: python manage.py collectstatic --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 3 --threads 4 --timeout 120
cron-notify: python manage.py run_scheduled notification_retry
cron-daily: python manage.py run_scheduled daily_maintenance
cron-weekly: python manage.py run_scheduled weekly_maintenance
