# ==========================================================================
# Hephzibah Luxe — backend environment template
# Copy to `.env` and fill in. Section order mirrors the real `.env`.
# On Railway, set each of these in the service's Variables tab (do NOT commit a
# real .env). Deploy checklist at the bottom.
# ==========================================================================

# REQUIRED — Django secret key. Generate a fresh one for prod, never reuse dev's:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# REQUIRED — True locally only. MUST be False on Railway / any real deploy.
DEBUG=True

# REQUIRED IN PRODUCTION — comma-separated hosts Django will serve. With
# DEBUG=False and this unset/empty, every request is rejected (DisallowedHost).
# Not needed in local dev (DEBUG=True bypasses the host check).
# Railway example: ALLOWED_HOSTS=hephzibah-api.up.railway.app,api.hephluxe.com
ALLOWED_HOSTS=

# OPTIONAL — origins trusted for admin POST/login behind HTTPS (Django needs the
# scheme). Defaults to each ALLOWED_HOST as https://, so leave blank unless you
# need to add another (e.g. a www host or a separate admin domain).
#   CSRF_TRUSTED_ORIGINS=https://api.hephluxe.com,https://www.hephluxe.com
CSRF_TRUSTED_ORIGINS=

# OPTIONAL (production) — force HTTP->HTTPS redirects. Off by default so it can't
# fight a platform's plain-HTTP healthcheck; turn on once HTTPS is confirmed end
# to end. Only read when DEBUG=False.
SECURE_SSL_REDIRECT=False

# OPTIONAL (production) — HSTS: tell browsers to only use HTTPS for this domain.
# Only read when DEBUG=False. Safe behind Railway's always-HTTPS edge (it's a
# response header, not a redirect). Start conservative and ramp up; set to
# 31536000 (1 year) before submitting to the browser preload list. 0 disables.
SECURE_HSTS_SECONDS=3600

# REQUIRED — Postgres connection URL (Neon/Railway/etc). Managed hosts want
# ?sslmode=require. On Railway, reference the Postgres plugin:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# REQUIRED — all outbound email (reminders, payment/meeting digests, phase
# updates, credentials, password resets, ...) sends via Brevo's transactional
# API. The app refuses to boot if BREVO_API_KEY is blank.
# See apps/notifications/services.py.
BREVO_API_KEY=
# One numeric Brevo template ID per notification type — build each template in
# the Brevo dashboard first, then paste its ID here. All eleven are REQUIRED
# (settings.py reads them as ints; a blank one fails at boot).
# See apps/notifications/README.md for the params each template expects.
BREVO_TEMPLATE_NEW_REMINDER=
BREVO_TEMPLATE_PAYMENT_DUE=
BREVO_TEMPLATE_MEETING_PREP_DUE=
BREVO_TEMPLATE_PHASE_ADVANCED=
BREVO_TEMPLATE_EVENT_DETAILS_UPDATED=
BREVO_TEMPLATE_DOCUMENT_ADDED=
BREVO_TEMPLATE_INVOICE_ISSUED=
BREVO_TEMPLATE_RECEIPT_ISSUED=
BREVO_TEMPLATE_MILESTONE_PAID=
BREVO_TEMPLATE_USER_CREDENTIALS=
BREVO_TEMPLATE_PASSWORD_RESET=

# REQUIRED — Redis. The app refuses to boot without REDIS_URL (Celery needs a
# broker). Broker + result backend share ONE DB index; the Django cache uses a
# SEPARATE index (below) so cache ops never touch the Celery queue.
#   - Home server: control panel allocates the pair, e.g. broker /8, cache /9.
#   - Railway: add the Redis plugin and reference it:
#       REDIS_URL=${{ Redis.REDIS_URL }}
#     (CELERY_BROKER_URL / CELERY_RESULT_BACKEND default to REDIS_URL if blank.)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# The data cache (faster loads + rate-limit counters) — its own Redis DB index,
# separate from the Celery broker above. Blank -> in-process LocMem.
# REQUIRED in production for correct cross-worker rate limiting (with LocMem
# each gunicorn worker counts separately). On Railway point it at the same Redis:
#   CACHE_REDIS_URL=${{ Redis.REDIS_URL }}
# /health/ready/ checks whichever is active.
CACHE_REDIS_URL=redis://localhost:6379/1

# REQUIRED — comma-separated browser origins allowed to call the API.
# Production: the deployed frontend origin(s), e.g.
#   CORS_ALLOWED_ORIGINS=https://hephluxe.com,https://www.hephluxe.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# REQUIRED — origin of the client portal, no trailing path. Every URL the backend
# puts in an email (login CTA, reminder deep links) is built from this, and it is
# never defaulted in code, so the app refuses to boot without it.
# Production: FRONTEND_BASE_URL=https://hephluxe.com
FRONTEND_BASE_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible media storage). REQUIRED in every real environment
# (dev, staging, production) — this platform has NO local-disk media path. Set
# USE_R2_STORAGE=True and fill the two keys (Cloudflare dashboard > R2 > Manage
# API Tokens). When False, media falls back to in-memory (RAM, non-persistent)
# storage used ONLY so the test suite / CI can run without R2 — never for real use.
USE_R2_STORAGE=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hepz
R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRE_SECONDS=3600

# ── Public display images (event covers, day images, contact photos) ──
# These are shown inline by the frontend and cached in an already-fetched event
# JSON payload, so a 1h SIGNED url (above) would become a broken image an hour
# later. Serve them from a SEPARATE PUBLIC R2 bucket with unsigned, long-lived
# URLs instead. Client documents/invoices/receipts ALWAYS stay on the signed
# bucket above. See apps/core/storages.py.
#   1. Create a second R2 bucket for public images.
#   2. Make it public: R2 > that bucket > Settings > enable the r2.dev subdomain,
#      or bind a custom domain (e.g. media.hephluxe.com).
#   3. Set both vars below to that bucket's name and its public URL.
# Leave BOTH blank to keep images on the signed bucket (they still work, just
# with the 1h signature) — a safe default, never broken images.
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_URL=https://<your-public-bucket>.r2.dev

# ==========================================================================
# OPTIONAL blocks below — NOT present in the minimal .env. Every value here is
# env-gated: blank disables it (safe for dev/CI). Recommended in production.
# ==========================================================================

# ── Observability standard (see docs/OBSERVABILITY_STANDARD.md) ──
# The app emits structured logs (-> Loki) + error/trace events (-> GlitchTip);
# the monitoring stack (Grafana/GlitchTip -> ntfy) decides alerts.
#
# "console" (human-readable, dev) or "json" (one object/line, Loki/Grafana).
# Use json on any real deploy.
LOG_FORMAT=console
# Root log level. DEBUG/INFO in dev, INFO/WARNING in prod.
LOG_LEVEL=INFO
# Tags every event; separates deploys on one stack. "production" on Railway,
# "homelab" on the home server, "development" locally.
SENTRY_ENVIRONMENT=development

# Loki push endpoint + HTTP basic-auth creds. Blank disables Loki push.
#   LOKI_PUSH_URL=http://192.168.2.21:3100/loki/api/v1/push  (home server LAN)
LOKI_PUSH_URL=
LOKI_PUSH_USER=
LOKI_PUSH_PASSWORD=

# GlitchTip (Sentry-compatible) DSN from a project you create in the GlitchTip
# UI. Blank disables Sentry.
SENTRY_DSN=
# Trace sampling (0.0 = none, 1.0 = 100%). Keep low in busy prod.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release tag; usually set automatically from the git SHA in CI.
# SENTRY_RELEASE=

# ── Rate limiting (django-ratelimit) ──
# Per-endpoint burst limits on the public auth/reset endpoints. Format
# "count/period" (period: s, m, h, d, or a multiple like 15m -> 5/15m = 5 per 15
# minutes). These defaults ship in code; override per deploy. Needs the shared
# Redis cache (CACHE_REDIS_URL) to count correctly across workers in production.
RATE_LIMIT_AUTH_LOGIN=5/m
RATE_LIMIT_TOKEN_REFRESH=30/m
RATE_LIMIT_PASSWORD_RESET_REQUEST=3/h
RATE_LIMIT_PASSWORD_RESET_VERIFY=10/m
RATE_LIMIT_PASSWORD_RESET_CONFIRM=10/m

# ==========================================================================
# Railway deploy checklist (all done in the Railway UI — no repo secrets):
#   1. Set every REQUIRED var above (DEBUG=False, ALLOWED_HOSTS=<domain>,
#      DATABASE_URL, BREVO_*, REDIS_URL, CACHE_REDIS_URL, CORS_ALLOWED_ORIGINS,
#      FRONTEND_BASE_URL). Turn on R2 (USE_R2_STORAGE=True + keys).
#   2. Add Railway Postgres + Redis plugins; reference them as shown above.
#   3. Separate services from the same repo: web (gunicorn), a Celery worker,
#      and a Celery beat — each needs the same env vars.
#   4. Run migrations + seed on release (manage.py migrate && seed_periodic_tasks).
#   See the code-side blockers noted in the audit before the first deploy.
# ==========================================================================
