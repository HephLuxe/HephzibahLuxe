# ==========================================================================
# Hephzibah Luxe — backend environment template
# Copy to `.env` and fill in. Section order mirrors the real `.env`.
# On Render, set each of these in the service's Environment tab -- or once in a
# shared Environment Group linked to all four services (do NOT commit a real
# .env). Deploy checklist at the bottom.
# ==========================================================================

# REQUIRED — Django secret key. Generate a fresh one for prod, never reuse dev's:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# REQUIRED — True locally only. MUST be False on Render / any real deploy.
DEBUG=True

# REQUIRED IN PRODUCTION — comma-separated hosts Django will serve. With
# DEBUG=False and this unset/empty, every request is rejected (DisallowedHost).
# Not needed in local dev (DEBUG=True bypasses the host check).
# Render example: ALLOWED_HOSTS=hephzibah-luxe-api.onrender.com,api.hephzibahluxe.com
ALLOWED_HOSTS=

# OPTIONAL — origins trusted for admin POST/login behind HTTPS (Django needs the
# scheme). Defaults to each ALLOWED_HOST as https://, so leave blank unless you
# need to add another (e.g. a www host or a separate admin domain).
#   CSRF_TRUSTED_ORIGINS=https://api.hephzibahluxe.com,https://www.hephzibahluxe.com
CSRF_TRUSTED_ORIGINS=

# OPTIONAL (production) — force HTTP->HTTPS redirects. Off by default so it can't
# fight a platform's plain-HTTP healthcheck; turn on once HTTPS is confirmed end
# to end. Only read when DEBUG=False.
SECURE_SSL_REDIRECT=False

# OPTIONAL (production) — HSTS: tell browsers to only use HTTPS for this domain.
# Only read when DEBUG=False. Safe behind Render's always-HTTPS edge (it's a
# response header, not a redirect). Start conservative and ramp up; set to
# 31536000 (1 year) before submitting to the browser preload list. 0 disables.
SECURE_HSTS_SECONDS=3600

# REQUIRED — Postgres connection URL (Neon). Managed hosts want ?sslmode=require.
# This deploy uses Neon directly, not a Render Postgres instance, so paste the
# Neon POOLED connection string (the `-pooler` host) verbatim.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# REQUIRED — all outbound email (reminders, payment/meeting digests, phase
# updates, credentials, password resets, ...) sends via Brevo's transactional
# API. The app refuses to boot if BREVO_API_KEY is blank.
# See apps/notifications/services.py.
BREVO_API_KEY=

# OPTIONAL — the From identity and Reply-To applied to EVERY transactional
# email. Blank (the default) means "use whatever each Brevo template is
# configured with", which is how this project behaved before these existed.
#
# Set them and the sending identity becomes a deploy-time value instead of
# dashboard state spread across thirteen templates: one env var and a redeploy
# switches who the platform mails as, and staging can send as something other
# than production. Brevo treats a per-send sender/replyTo as an override of the
# template's own. The address must still exist as a verified sender in Brevo.
#
# BREVO_SENDER_NAME without BREVO_SENDER_EMAIL fails at boot — Brevo needs the
# address to apply the name, so the name alone would be silently dropped.
BREVO_SENDER_EMAIL=clientsupport@hephzibahluxe.com
BREVO_SENDER_NAME=Hephzibah Luxe Client Support
BREVO_REPLY_TO_EMAIL=tosin@hephzibahluxe.com
#
# Per-template override of the identity above, for the one template that is NOT
# client-facing: inquiry_submitted_internal alerts YOUR staff about a new lead,
# so a client-support From reads wrong on it. Setting the email switches that
# template alone; every other template keeps the platform identity.
#
# The sender email and name here travel together — set the email and this name
# is used with it, rather than inheriting BREVO_SENDER_NAME, which would
# otherwise produce "Hephzibah Luxe Client Support <alerts@...>". The reply-to
# falls back to BREVO_REPLY_TO_EMAIL on its own unless set here.
BREVO_SENDER_EMAIL_INQUIRY_INTERNAL=alerts@hephzibahluxe.com
BREVO_SENDER_NAME_INQUIRY_INTERNAL=Hephzibah Luxe Lead Alerts
BREVO_REPLY_TO_EMAIL_INQUIRY_INTERNAL=
# One numeric Brevo template ID per notification type — build each template in
# the Brevo dashboard first, then paste its ID here. All thirteen are REQUIRED
# (settings.py reads them as ints; a blank one fails at boot).
# See apps/notifications/README.md for the params each template expects.
# Brevo template IDs are ACCOUNT-SCOPED — id 12 in a sandbox account is a
# different template in production. Deliberately no defaults in settings.py: a
# missing one must stop the boot, never silently send the wrong email. Copy them
# from the Brevo account this deploy actually points at.
BREVO_TEMPLATE_NEW_REMINDER=
BREVO_TEMPLATE_PAYMENT_DUE=
BREVO_TEMPLATE_MEETING_PREP_DUE=
BREVO_TEMPLATE_PHASE_ADVANCED=
BREVO_TEMPLATE_EVENT_DETAILS_UPDATED=
BREVO_TEMPLATE_DOCUMENT_ADDED=
BREVO_TEMPLATE_INVOICE_ISSUED=
BREVO_TEMPLATE_RECEIPT_ISSUED=
BREVO_TEMPLATE_MILESTONE_PAID=
BREVO_TEMPLATE_USER_CREDENTIALS=
BREVO_TEMPLATE_PASSWORD_RESET=
BREVO_TEMPLATE_INQUIRY_RECEIVED=
BREVO_TEMPLATE_INQUIRY_SUBMITTED_INTERNAL=

# The one Redis this project needs. There is no REDIS_URL and no CELERY_* vars
# any more: background work runs in-process and scheduling is platform cron
# (docs/adr/0001-remove-celery.md), so Redis' whole job is the Django cache —
# rate-limit counters, the inquiry double-submit dedupe window, /health/ready/.
#
# Blank -> in-process LocMem, which is fine in dev. REQUIRED in production and
# enforced at boot when DEBUG=False: LocMem is per-PROCESS, and the Procfile runs
# `gunicorn --workers 3`, so every rate limit would silently become 3x its
# configured value and the dedupe window would miss two clicks out of three.
#   - Home server: the control panel allocates a dedicated cache index, e.g. /9.
#   - Render: this deploy uses Upstash directly, not a Render Key Value
#     instance. Paste the Upstash `rediss://` URL verbatim, and keep the
#     `/0?ssl_cert_reqs=required` suffix -- without the `/0?` the port fails to
#     parse and every cache call raises at boot.
CACHE_REDIS_URL=redis://localhost:6379/1

# OPTIONAL — the calendar timezone assumed for an account that hasn't set its own
# (accounts.User.timezone, writable via PATCH /users/me/update/ or the admin).
#
# NOT the same thing as Django's TIME_ZONE, which stays UTC and governs how
# *instants* are stored. This one answers "what day is it for this client?", which
# is what the daily payment-due and meeting-prep digests need: they compare against
# DateFields that mean a calendar day where the client lives, and UTC's today is a
# different day for anyone far enough from UTC. See apps/core/timezones.py.
#
# Any IANA name. Validated at boot — a typo would otherwise shift the digests for
# every account without its own timezone, silently.
# PLATFORM_DEFAULT_TIMEZONE=UTC

# ── PLATFORM_DEVELOPER_EMAILS ─────────────────────────────────────────────────
# OPTIONAL, but set it on any deploy you administer. Comma-separated addresses
# that hold the `developer` role — the one role above admin, and the only one an
# admin cannot revoke. See docs/adr/0004-protected-developer-role.md.
#
# WHY THIS IS AN ENV VAR AND NOT JUST A ROLE IN THE DATABASE
# `role=admin` sets is_superuser=True, and Django grants a superuser every
# permission on every model unconditionally. So an admin account — the kind you
# hand a frontend contractor so they can test the platform — can change your
# role, change your email (it is the login identity, so every future
# password-reset code follows it), set your password outright, deactivate you,
# or delete your row. Recovery from any of those needs a shell on the production
# web service, which is a paid-tier feature on Render.
#
# Anchoring the answer here puts it behind a different credential: the Render
# dashboard or this file, neither of which a platform login reaches. Accounts
# listed here are repaired to full privilege on every save and before every
# sign-in, so a demotion written straight into the database is undone the next
# time you log in.
#
# EMPTY IS VALID and means "no protected accounts" — the right value for CI, a
# reviewer's checkout, or any deploy with no developer account. It never means
# "everybody".
#
# Case-insensitive, whitespace-tolerant, validated at boot (a malformed entry
# raises rather than silently protecting nobody).
#
# After setting it, run `python manage.py ensure_developer` — idempotent, safe on
# every deploy, and best placed in the release phase so the account survives a
# database restore. It creates the account if missing and repairs it if drifted;
# it never resets an existing password.
# PLATFORM_DEVELOPER_EMAILS=you@example.com,cofounder@example.com

# OPTIONAL — background thread pool sizing (apps/core/background.py). Defaults
# are almost certainly right; documented so the knobs are discoverable.
#   BACKGROUND_MAX_WORKERS — threads available for deferred work. 4.
#   BACKGROUND_MAX_QUEUED  — jobs queued-or-running before dispatch degrades to
#                            running inline in the calling thread. 100. Slower,
#                            never lossy.
#   BACKGROUND_EAGER       — force every .delay() inline, even in the web
#                            process. False; forced True under the test runner.
#                            Set it locally to debug a task synchronously inside
#                            the request that triggered it.
# BACKGROUND_MAX_WORKERS=4
# BACKGROUND_MAX_QUEUED=100
# BACKGROUND_EAGER=False

# REQUIRED — comma-separated browser origins allowed to call the API.
# Production: the deployed frontend origin(s), e.g.
#   CORS_ALLOWED_ORIGINS=https://hephzibahluxe.com,https://www.hephzibahluxe.com,https://portal.hephzibahluxe.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# REQUIRED — origin of the client portal, no trailing path. Every URL the backend
# puts in an email (login CTA, reminder deep links) is built from this, and it is
# never defaulted in code, so the app refuses to boot without it.
# Production: FRONTEND_BASE_URL=https://portal.hephzibahluxe.com
# This is the PORTAL's origin specifically, not the marketing site — every
# email link is built from it, so pointing it at the apex sends clients to
# the public site instead of the app they were asked to log into.
FRONTEND_BASE_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible media storage). REQUIRED in every real environment
# (dev, staging, production) — this platform has NO local-disk media path. Set
# USE_R2_STORAGE=True and fill the two keys (Cloudflare dashboard > R2 > Manage
# API Tokens). When False, media falls back to in-memory (RAM, non-persistent)
# storage used ONLY so the test suite / CI can run without R2 — never for real use.
USE_R2_STORAGE=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hepz
R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
# Expiry for URLs serialized DIRECTLY from the signed bucket. Note that the
# client-facing private files (documents, invoices, receipts, budget receipts,
# prep uploads, contact photos) no longer take this path at all — they are minted
# per request by GET /api/v1/files/<type>/<id>/ with a 60s expiry, after an
# ownership check. See apps/core/filelinks.py.
R2_SIGNED_URL_EXPIRE_SECONDS=3600

# ── Public display images (event/day galleries, team photos) ──
# World-readable by design and shown inline, so they are cached in
# already-fetched JSON, in the CDN, in the browser and in a static site build —
# a signature (above) would turn every one of those copies into a broken image
# when it expires. Serve them from a SEPARATE PUBLIC R2 bucket with unsigned,
# permanent URLs instead.
#
# NOT public: client documents, invoices, receipts, budget receipts, prep
# uploads, and CONTACT PHOTOS (the client's family, bridal party and vendors —
# they render only inside an authenticated portal). Those stay on the signed
# bucket above. See apps/core/storages.py for the full tier split.
#   1. Create a second R2 bucket for public images.
#   2. Make it public: R2 > that bucket > Settings > enable the r2.dev subdomain,
#      or bind a custom domain (e.g. media.hephzibahluxe.com).
#   3. Set both vars below to that bucket's name and its public URL.
# Prefer a CUSTOM DOMAIN over the r2.dev subdomain: it keeps the URLs on your own
# domain instead of Cloudflare's, and it is the one thing that makes the public
# portfolio API (GET /api/v1/portfolio/events/) usable by an anonymous visitor.
# Leave BOTH blank to keep images on the signed bucket (they still work, just
# with the 1h signature) — a safe default, never broken images.
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_URL=https://<your-public-bucket>.r2.dev

# ==========================================================================
# OPTIONAL blocks below — NOT present in the minimal .env. Every value here is
# env-gated: blank disables it (safe for dev/CI). Recommended in production.
# ==========================================================================

# ── Observability standard (see docs/OBSERVABILITY_STANDARD.md) ──
# The app emits structured logs (-> Loki) + error/trace events (-> GlitchTip);
# the monitoring stack (Grafana/GlitchTip -> ntfy) decides alerts.
#
# "console" (human-readable, dev) or "json" (one object/line, Loki/Grafana).
# Use json on any real deploy.
LOG_FORMAT=console
# Root log level. DEBUG/INFO in dev, INFO/WARNING in prod.
LOG_LEVEL=INFO
# Tags every event; separates deploys on one stack. "production" on Render,
# "homelab" on the home server, "development" locally.
SENTRY_ENVIRONMENT=development

# Loki push endpoint + HTTP basic-auth creds. Blank disables Loki push.
#   LOKI_PUSH_URL=http://192.168.2.21:3100/loki/api/v1/push  (home server LAN)
LOKI_PUSH_URL=
LOKI_PUSH_USER=
LOKI_PUSH_PASSWORD=

# GlitchTip (Sentry-compatible) DSN from a project you create in the GlitchTip
# UI. Blank disables Sentry.
SENTRY_DSN=
# Trace sampling (0.0 = none, 1.0 = 100%). Keep low in busy prod.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release tag; usually set automatically from the git SHA in CI.
# SENTRY_RELEASE=

# ── Rate limiting (OVERRIDES ONLY — the numbers live in config/settings.py) ──
# Every rate-limit and throttle NUMBER is declared in config/settings.py, in the
# block headed "Rate limiting: every number, one place". Read it there; that is
# the policy.
#
# The vars below exist only to override one of those numbers for a single deploy
# without a code change. They are COMMENTED OUT on purpose: an uncommented value
# here would be a second copy of the number, and the two would drift — which is
# exactly how the old RATE_LIMIT_INQUIRY_SUBMIT ended up documented in three
# places at two different values. Uncomment one only while you are actively
# tuning it, and fold the result back into settings.py when you settle.
#
# Format is "count/period" (period: s, m, h, d, or a multiple like 10m -> 6/10m
# = 6 per 10 minutes).
#
# REQUIRED for any of this to mean anything in production: CACHE_REDIS_URL must
# point at Redis. The counters live in the Django cache and the LocMem fallback
# is per-process, so with `gunicorn --workers 3` every limit would be silently
# tripled. That is now a boot error when DEBUG=False rather than a silent bug.

# Per-endpoint limits. Login and the inquiry form are each limited on TWO axes —
# see settings.py for why the second axis is the load-bearing one in both cases.
#RATE_LIMIT_AUTH_LOGIN=10/m
#RATE_LIMIT_AUTH_LOGIN_ACCOUNT=10/h
#RATE_LIMIT_TOKEN_REFRESH=30/m
#RATE_LIMIT_PASSWORD_RESET_REQUEST=3/h
#RATE_LIMIT_PASSWORD_RESET_VERIFY=10/m
#RATE_LIMIT_PASSWORD_RESET_CONFIRM=10/m
#RATE_LIMIT_INQUIRY_SUBMIT_BURST=6/10m
#RATE_LIMIT_INQUIRY_SUBMIT_IP=10/h

# The Django admin's own login form, /admin/login/. Separate IP groups from
# AUTH_LOGIN so operator traffic and public API traffic never draw down each
# other's buckets; the ACCOUNT tiers above are shared with the API on purpose.
# Tighter than the API's 10/m because the admin has a handful of human users
# and no programmatic callers — nothing legitimate here retries.
#RATE_LIMIT_ADMIN_LOGIN=5/m

# Daily caps, one per anonymous endpoint. The per-minute limits above cap a
# BURST and nothing else — 10/m sustained is 14,400 login attempts a day. These
# used to come from the shared THROTTLE_ANON bucket, which counted every
# unauthenticated endpoint together per IP, so a morning of failed logins could
# leave someone behind the same NAT unable to finish a password reset.
#RATE_LIMIT_AUTH_LOGIN_DAILY=100/d
# Keyed on the submitted email, not the IP. Must stay ABOVE User.MAX_FAILED_LOGINS
# (5) or a locked account reports an opaque 429 instead of the reset instruction.
#RATE_LIMIT_AUTH_LOGIN_ACCOUNT_DAILY=50/d
#RATE_LIMIT_TOKEN_REFRESH_DAILY=500/d
#RATE_LIMIT_PASSWORD_RESET_REQUEST_DAILY=20/d
#RATE_LIMIT_PASSWORD_RESET_VERIFY_DAILY=50/d
#RATE_LIMIT_PASSWORD_RESET_CONFIRM_DAILY=20/d
#RATE_LIMIT_ADMIN_LOGIN_DAILY=50/d

# Project-wide ceilings (DRF throttles), applied on top of the per-endpoint
# limits above.
#
# `anon` is a SAFETY NET, not the binding limit: one bucket per client IP across
# every unauthenticated endpoint at once, so it cannot tell a login flood from a
# password reset, nor one person from a whole office behind NAT. The real daily
# caps are the per-endpoint ones above. What it is still for is an endpoint
# nobody remembered to wire a limit onto — so keep it comfortably above the sum
# of those caps, or it silently becomes the primary limit again. The inquiry form
# opts out of it entirely.
#
# `user_burst` is per ACCOUNT and is the only limit on authenticated traffic; it
# does not apply to anonymous callers at all. Keep it a per-MINUTE rate — a /day
# value lets one runaway frontend loop lock a real person out for hours.
#THROTTLE_ANON=1000/day
#THROTTLE_USER_BURST=120/m

# Occupancy signal: log event="throttle_near_limit" once a bucket reaches this
# fraction of its ceiling. Lower it to hear earlier.
#THROTTLE_NEAR_LIMIT_FRACTION=0.8

# Retry-After advertised on a django-ratelimit 429 (its fixed windows don't
# expose when the current one closes, so this is a conservative constant).
#RATELIMIT_RETRY_AFTER_SECONDS=60

# Not a rate limit: how long an IDENTICAL inquiry submission is treated as a
# double-click rather than a second lead. Must stay <= the burst window above.
#INQUIRY_DEDUPE_WINDOW_SECONDS=120

# NOTE: RATE_LIMIT_INQUIRY_SUBMIT no longer exists. It was replaced by the two
# _BURST / _IP vars above. An unknown env var is ignored silently, so if it is
# still set anywhere the symptom is inquiry limits that don't respond to tuning.

# ── reCAPTCHA v3 (public inquiry form) ──
# OPTIONAL — Google reCAPTCHA **v3** secret key (the SITE key lives in the
# frontend). Blank (the default) skips verification entirely, so dev/CI/tests
# need no config; set it in production to have the submitted recaptcha_token
# checked against Google. Verification fails OPEN on a network error — a Google
# outage must not cost a real lead. See apps/inquiries/recaptcha.py.
#
# Provision a v3 key, not v2. The code reads `score` and the token's `action`;
# a v2 secret answers with neither, which is logged as an error at ERROR level
# and falls back to v2 semantics rather than rejecting every submission.
# ONE key pair is meant to cover every public form on the domain — the action
# check, not key separation, is what keeps that safe.
RECAPTCHA_SECRET_KEY=

# Minimum v3 score (0.0 bot … 1.0 human) each action must clear. 0.5 is Google's
# suggested starting point; retune from the score distribution the reCAPTCHA
# console plots for your live traffic. Err LOW on lead capture — a wrongly
# rejected inquiry is a lead you never find out about.
#
# 0.0 here is deliberate and TEMPORARY: it is monitor mode. Every token is still
# verified (so the console accumulates a real score distribution) and the action
# check and success check still reject, but nothing is turned away on score
# while there is no data to choose a threshold from. Raise it once the console
# shows what your genuine traffic actually scores.
RECAPTCHA_MIN_SCORE_SUBMIT_INQUIRY=0.0

# Applied to any action with no dedicated variable above. NOT monitor mode, and
# deliberately not 0.0: this only governs an action nobody has registered a
# threshold for — a future endpoint someone wires up and forgets — so a 0.0 here
# would wave that endpoint through unscored and nothing would ever surface it.
RECAPTCHA_MIN_SCORE_DEFAULT=0.5

# ==========================================================================
# Render deploy checklist (all done in the Render dashboard — no repo secrets):
#   1. Put every REQUIRED var above into ONE Environment Group (Render dashboard
#      -> Env Groups), then link that group to all four services. settings.py
#      fails fast on a missing key, so a cron service missing one BREVO_TEMPLATE_*
#      will crash-loop exactly as the old worker did — a shared group is what
#      keeps the four in sync. Set DEBUG=False, ALLOWED_HOSTS=<domain>, and turn
#      on R2 (USE_R2_STORAGE=True + keys).
#   2. No Render Postgres or Key Value instance. Postgres is Neon and the cache is
#      Upstash, both reached over the public internet with TLS. Pick the Ohio
#      region for every service: Neon lives in us-east-2, so any other region adds
#      a cross-region round trip to every query.
#   3. Four services from the same repo — one web and three cron:
#        web          Web Service  gunicorn (start command below)
#        cron-notify  Cron Job     run_scheduled notification_retry  */10 * * * *
#        cron-daily   Cron Job     run_scheduled daily_maintenance   0 8 * * *
#        cron-weekly  Cron Job     run_scheduled weekly_maintenance  0 3 * * 1
#      Render cron schedules are UTC, same as the Railway ones they replace, so
#      the expressions carry over unchanged. A cron job runs and exits, so it
#      bills execution time rather than 24/7 — but note Render cron jobs are not
#      offered on the free tier and floor at ~$1/mo each.
#
#      Web build command:
#        pip install -r requirements.txt && python manage.py collectstatic --noinput && python manage.py migrate --noinput
#      Web start command:
#        gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --threads 4 --timeout 120
#      Cron build command (NO migrate — see 4):
#        pip install -r requirements.txt
#      Health check path: /health/
#
#   4. `manage.py migrate` runs in the WEB service's BUILD command only. Render's
#      dedicated pre-deploy command is a paid-tier feature, so on the free tier
#      the build command is where it goes. Do not add it to a cron service — two
#      services migrating concurrently on a fresh database is the race that used
#      to break beat.
#   5. Free-tier web services sleep after 15 minutes of no traffic and take ~1
#      minute to wake, and they have no SSH or dashboard shell — so
#      `manage.py release_login_lock` cannot be run against production until the
#      web service is on a paid plan.
# ==========================================================================
