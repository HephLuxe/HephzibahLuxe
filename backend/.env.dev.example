# ==========================================================================
# Hephzibah Luxe — LOCAL DEVELOPMENT env template (no secrets).
# Copy to backend/.env.dev and run with DJANGO_ENV_FILE=.env.dev so settings
# read this file instead of backend/.env. See RUNBOOK.md "Local development".
# Nothing here talks to a real service: local Postgres, no R2, no Redis, no
# Sentry/Loki, and a placeholder Brevo key (sends are attempted and fail; the
# failure is caught and logged — they never reach a real inbox).
# ==========================================================================

DJANGO_SECRET_KEY=local-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres (e.g. `brew services start postgresql@18 && createdb hephluxe_dev`).
DATABASE_URL=postgres://localhost:5432/hephluxe_dev

# Media: R2 off, local disk on -> files under backend/media/, served at /media/
# by runserver (DEBUG only).
USE_R2_STORAGE=False
USE_LOCAL_MEDIA=True

# Blank -> in-process LocMem cache (allowed because DEBUG=True).
CACHE_REDIS_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000/

# Placeholder Brevo key + template ids (same throwaway values CI uses).
BREVO_API_KEY=local-dev-placeholder-key
BREVO_TEMPLATE_NEW_REMINDER=1
BREVO_TEMPLATE_PAYMENT_DUE=1
BREVO_TEMPLATE_MEETING_PREP_DUE=1
BREVO_TEMPLATE_PHASE_ADVANCED=1
BREVO_TEMPLATE_EVENT_DETAILS_UPDATED=1
BREVO_TEMPLATE_DOCUMENT_ADDED=1
BREVO_TEMPLATE_INVOICE_ISSUED=1
BREVO_TEMPLATE_RECEIPT_ISSUED=1
BREVO_TEMPLATE_MILESTONE_PAID=1
BREVO_TEMPLATE_USER_CREDENTIALS=1
BREVO_TEMPLATE_PASSWORD_RESET=1
BREVO_TEMPLATE_INQUIRY_RECEIVED=1
BREVO_TEMPLATE_INQUIRY_SUBMITTED_INTERNAL=1

# Observability off locally.
SENTRY_DSN=
LOKI_PUSH_URL=
