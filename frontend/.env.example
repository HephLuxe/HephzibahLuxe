# Base URL of the Django API (no trailing slash).
# Production: https://api.hephzibahluxe.com
# API_BASE_URL is read server-side; NEXT_PUBLIC_API_BASE_URL is the fallback
# and is also exposed to the browser bundle.
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Homepage decorative photos: GET /api/v1/public/home-strip/ on this origin.
# Shared with portfolio: ordered backend content, 300-second server revalidation.
# No static photo fallback; image hosts must match next.config.ts remotePatterns.
